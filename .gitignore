*.log
.DS_Store
Thumbs.db

# Local hardware workspaces and helper tools are maintained outside software pushes.
prototype/
tools/*
!tools/acquisition/
!tools/acquisition/**
tools/acquisition/.venv/
!tools/arduino-cli/
tools/arduino-cli/*
!tools/arduino-cli/README.md
!tools/arduino-cli/LICENSE.txt
screenshot/

# Firmware sources are tracked; only generated compiler copies are local.
firmware/.build/

# Keep generated Python state ignored after the acquisition source whitelist.
__pycache__/
*.py[cod]

# Acquisition output is local experiment data, not source code.
*.mat

# Local inspection and generated helper outputs.
$out
.codex_*
.codex/
.agents/
